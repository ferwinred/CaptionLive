# Copy to .env and fill in. Every variable is optional except the API key for Gemini.
CL_ADMIN_TOKEN=pick-a-long-random-secret
GEMINI_API_KEY=your-google-ai-studio-key
CL_PUBLIC_URL=https://captions.example.org

# Providers
CL_ASR_PROVIDER=gemini            # gemini | whisper | mock
CL_GEMINI_ASR_MODEL=gemini-3.5-transcribe-live
CL_MT_PROVIDER=gemini             # gemini | openai | mock | none
CL_GEMINI_MT_MODEL=gemini-2.5-flash-lite

# Scale-out (several replicas / workers)
CL_BROKER=memory                  # memory | redis
CL_REDIS_URL=redis://redis:6379/0

# Sessions to create on start-up
CL_SESSIONS_FILE=examples/sessions.yaml

# 100% local alternative (no cloud): faster-whisper + Gemma on Ollama
# CL_ASR_PROVIDER=whisper
# CL_WHISPER_MODEL=small
# CL_MT_PROVIDER=openai
# CL_OPENAI_BASE_URL=http://ollama:11434/v1
# CL_OPENAI_MODEL=gemma3:4b
